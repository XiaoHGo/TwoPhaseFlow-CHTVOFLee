FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 373.15;

boundaryField
{
   bottom
    {
        type            externalWallHeatFluxTemperature;
        mode            flux;
        q               uniform 1000000;
        kappaMethod     solidThermo;
        kappa           none;
        value           uniform 378.15;
    }

    left
    {
        type            zeroGradient;
        value           $internalField;
    }

    right
    {
        type            zeroGradient;
        value           $internalField;
    }

    frontAndBack
    {
        type            empty;
    }

    "solid_to_fluid_.*"
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        kappa           none;
        value           uniform 373.15;
    }
}

