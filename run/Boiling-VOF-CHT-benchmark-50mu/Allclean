#!/bin/sh
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
#------------------------------------------------------------------------------

# Remove time directories (keep 0)
for dir in $(ls -d [1-9]* 2>/dev/null) $(ls -d 0.[0-9]* 2>/dev/null); do
    [ -d "$dir" ] && rm -rf "$dir"
done

# Remove processor directories
rm -rf processor*

# Remove log files
rm -f log.*
rm -f *.OpenFOAM

# Remove postProcessing
rm -rf postProcessing

# Remove 0 directory (restored from 0.orig by Allrun)
rm -rf 0

# Remove region directories created by splitMeshRegions
rm -rf constant/fluid/polyMesh constant/solid/polyMesh
rm -rf constant/domain* system/domain* 
rm -rf dynamicCode/

# Remove cellToRegion field
rm -f constant/cellToRegion

# Remove polyMesh generated files (keep blockMeshDict)
rm -rf constant/polyMesh/

#------------------------------------------------------------------------------
