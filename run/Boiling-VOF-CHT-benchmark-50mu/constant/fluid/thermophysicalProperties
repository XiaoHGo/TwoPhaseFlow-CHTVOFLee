FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (water vapor);

pMin            pMin [ 1 -1 -2 0 0 0 0 ] 50000;

sigma           sigma [ 1 0 -2 0 0 0 0 ] 0.0089;//0.0089004;

TMin            TMin [0 0 0 1 0 0 0] 200.0;

TMax            TMax [0 0 0 1 0 0 0] 400.0;

water
{
    type pureMovingPhaseModel;
}

vapor
{
    type pureMovingPhaseModel;
}

surfaceForces
{
  sigma 0.0089;
  surfaceTensionForceModel gradAlpha;
  accelerationForceModel gravity;
  deltaFunctionModel alphaCSF;
}


