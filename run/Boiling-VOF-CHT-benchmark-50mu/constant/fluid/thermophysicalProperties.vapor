FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Gas phase: water vapour
// Hf(vapour) = 0: reference enthalpy, latent heat comes from
//   Hf(vapour) - Hf(liquid) = 0 - (-2.257e6) = 2.257 MJ/kg

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const; // tabulated; 
    thermo          hConst; // hTabulated
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight   18.0;
    }
    thermodynamics
    {
        Cp         2257;
        Hf            0;
        Sf            0;
