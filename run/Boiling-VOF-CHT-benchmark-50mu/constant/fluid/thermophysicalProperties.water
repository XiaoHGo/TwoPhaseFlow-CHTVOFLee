FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Liquid water properties at ~100°C (373 K), 1 atm
// Hf = -2.257e6 J/kg: latent heat offset so that
//   Hf(gas.vapour) - Hf(liquid) = 0 - (-2.257e6) = 2.257 MJ/kg
// giving correct latent heat in Lee model energy source

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight   18.015;
    }
    equationOfState
    {
        rho0        958.4;                        // liquid water at 100°C [kg/m³]
        T0          373;
        beta        6.9e-4;
    }
    thermodynamics
    {
        Cp          4216.0;                       // [J/kg/K]
        Hf          0;                            // latent heat offset [J/kg], set in phasechange model seperately
    }
    transport
    {
        mu          0.00028176;                   // [Pa·s] at 100°C
        Pr          1.7703430104321904;
    }
}

// ************************************************************************* //
