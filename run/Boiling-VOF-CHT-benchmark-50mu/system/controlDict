FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     multiRegionBoilingFlow;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         7e-3;

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   0.1e-3;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression on;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       1;
maxDi           500;
maxCapillaryNum 1;

libs
(
    "libpostProcess.so"
    "libfluidThermo.so"
);

functions
{

    intPsi
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");

        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        log             true;
        region          fluid;

        operation       volIntegrate;

        fields
        (
            psi0_
        );

    }

}

