FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// refer to fluid.fms file

dictionaryReplacement
{
    boundary
    {
        fluid_to_solid_ribtop
        {
            type        mappedWall;
            inGroups    1 (wall);
            sampleMode  nearestPatchFace;
            sampleRegion solid;
            samplePatch solid_to_fluid_ribtop;
        }
        fluid_to_solid_ribside
        {
            type        mappedWall;
            inGroups    1 (wall);
            sampleMode  nearestPatchFace;
            sampleRegion solid;
            samplePatch solid_to_fluid_ribside;
        }
        fluid_to_solid_slotbot
        {
            type        mappedWall;
            inGroups    1 (wall);
            sampleMode  nearestPatchFace;
            sampleRegion solid;
            samplePatch solid_to_fluid_slotbot;
        }
    }
}

